{
  // Table Planner — Cloudflare Worker + static assets.
  "name": "table-planner",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Create with: npx wrangler kv namespace create PLANNER  — then paste the id here.
  "kv_namespaces": [{ "binding": "PLANNER", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  // Hourly at :01 — catches midnight UK releases in both GMT and BST.
  "triggers": { "crons": ["1 * * * *"] },
  "observability": { "enabled": true }
}
