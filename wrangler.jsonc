{
  // Table Planner — Cloudflare Worker + static assets.
  "name": "table-planner",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No id needed: Cloudflare creates this storage automatically on the first deploy.
  "kv_namespaces": [{ "binding": "PLANNER" }],
  // Hourly at :01 — catches midnight UK releases in both GMT and BST.
  "triggers": { "crons": ["1 * * * *"] },
  "observability": { "enabled": true }
}
